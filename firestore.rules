rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // =================================
    //         HELPER FUNCTIONS
    // =================================
    
    function isSignedIn() {
      return request.auth != null;
    }

    function isSchoolMember(schoolId) {
      let userPath = /databases/$(database)/documents/users/$(request.auth.uid);
      let schoolPath = /databases/$(database)/documents/ecoles/$(schoolId);
      
      let isExplicitDirector = exists(schoolPath) && get(schoolPath).data.directorId == request.auth.uid;
      
      return isSignedIn() && (
        isExplicitDirector ||
        (exists(userPath) && (
          get(userPath).data.isSuperAdmin == true ||
          (
            'schools' in get(userPath).data &&
            get(userPath).data.schools != null &&
            schoolId in get(userPath).data.schools
          )
        ))
      );
    }
    
    function isDirector(schoolId) {
      let userPath = /databases/$(database)/documents/users/$(request.auth.uid);
      let schoolPath = /databases/$(database)/documents/ecoles/$(schoolId);
      
      let isExplicitDirector = exists(schoolPath) && get(schoolPath).data.directorId == request.auth.uid;
      let hasDirectorRole = exists(userPath) && 
                           'schools' in get(userPath).data && 
                           schoolId in get(userPath).data.schools && 
                           get(userPath).data.schools[schoolId] == 'directeur';

      return isSignedIn() && (isExplicitDirector || hasDirectorRole);
    }
    
    function isSuperAdmin() {
      let userPath = /databases/$(database)/documents/users/$(request.auth.uid);
      return isSignedIn() && 
             exists(userPath) && 
             get(userPath).data.isSuperAdmin == true;
    }

    function hasPermission(schoolId, permission) {
      let staffPath = /databases/$(database)/documents/ecoles/$(schoolId)/personnel/$(request.auth.uid);
      // Résout le nom du rôle admin de l'utilisateur, ou un segment sentinelle
      // s'il n'a pas de fiche personnel. La sentinelle garde rolePath comme
      // référence de document valide ; exists() renverra simplement false et
      // hasExplicitPermission restera false. (Inliner get(staffPath).data.adminRole
      // directement dans $() à plusieurs reprises fait planter l'évaluation —
      // les expressions dynamiques dans les templates de chemin sont fragiles.)
      let adminRole = exists(staffPath) && 'adminRole' in get(staffPath).data && get(staffPath).data.adminRole is string
                      ? get(staffPath).data.adminRole
                      : '__none__';
      let rolePath = /databases/$(database)/documents/ecoles/$(schoolId)/admin_roles/$(adminRole);

      let hasExplicitPermission = adminRole != '__none__' &&
        exists(rolePath) &&
        'permissions' in get(rolePath).data &&
        permission in get(rolePath).data.permissions &&
        get(rolePath).data.permissions[permission] == true;

      return isSuperAdmin() || isDirector(schoolId) || hasExplicitPermission;
    }

    // Prend schoolId/studentId plutôt qu'un document déjà résolu par get() :
    // un get() sur un document inexistant lève une erreur qui casse toute
    // l'évaluation de la règle (donc refuse l'accès même à un membre de
    // l'école légitime, côté droit d'un `||`, si le || ne peut pas
    // court-circuiter). Un élève supprimé alors que ses notes/absences/
    // incidents subsistent (Firestore ne supprime pas les sous-collections
    // en cascade) suffit à déclencher ce cas. exists() d'abord évite ça.
    function isParentOfStudent(schoolId, studentId) {
      let studentPath = /databases/$(database)/documents/ecoles/$(schoolId)/eleves/$(studentId);
      return isSignedIn() && exists(studentPath) &&
             'parentIds' in get(studentPath).data &&
             get(studentPath).data.parentIds != null &&
             request.auth.uid in get(studentPath).data.parentIds;
    }

    // =================================
    //   PLAN QUOTAS (defense in depth)
    // =================================
    //
    // Limites par plan (gardées identiques à src/lib/subscription-plans.ts) :
    // - Essentiel : 50 élèves, 5 cycles
    // - Pro & Premium : illimité
    //
    // Les compteurs sont maintenus côté client par StudentService /
    // CyclesService (stats/finance.studentCount, stats/structure.cyclesCount).
    // Un client qui ne les met pas à jour ne peut pas dépasser le plafond,
    // car la règle bloque dès que le compteur atteint la limite.

    function planMaxStudents(plan) {
      return plan == 'Essentiel' ? 50 : 999999;
    }

    function planMaxCycles(plan) {
      return plan == 'Essentiel' ? 5 : 999999;
    }

    function schoolPlan(schoolId) {
      let schoolPath = /databases/$(database)/documents/ecoles/$(schoolId);
      return exists(schoolPath)
        ? get(schoolPath).data.get(['subscription', 'plan'], 'Essentiel')
        : 'Essentiel';
    }

    function currentStudentCount(schoolId) {
      let statsPath = /databases/$(database)/documents/ecoles/$(schoolId)/stats/finance;
      return exists(statsPath) ? get(statsPath).data.get('studentCount', 0) : 0;
    }

    function currentCycleCount(schoolId) {
      let statsPath = /databases/$(database)/documents/ecoles/$(schoolId)/stats/structure;
      return exists(statsPath) ? get(statsPath).data.get('cyclesCount', 0) : 0;
    }

    function passesStudentQuota(schoolId) {
      return isSuperAdmin() || currentStudentCount(schoolId) < planMaxStudents(schoolPlan(schoolId));
    }

    function passesCycleQuota(schoolId) {
      return isSuperAdmin() || currentCycleCount(schoolId) < planMaxCycles(schoolPlan(schoolId));
    }
    
    // =================================
    //         PUBLIC COLLECTIONS
    // =================================

    match /contact_requests/{requestId} {
      allow create: if true;
      allow read, update, delete: if isSuperAdmin();
    }

    match /survey_responses/{responseId} {
      allow create: if true;
      allow read, update, delete: if isSuperAdmin();
    }
    
    match /sessions_parents/{sessionId} {
      // La création reste ouverte : le staff génère un code d'accès depuis le
      // client (ParentAccessGenerator) sans lien de permission vérifiable ici.
      // Le point sensible était `allow read: if true` qui rendait TOUS les
      // codes énumérables. La lecture (comme update/delete) est donc désormais
      // réservée au super-admin ; la validation d'un code se fait côté serveur
      // (SDK admin, hors règles).
      allow create: if true;
      allow read, update, delete: if isSuperAdmin();
    }

    match /mail/{mailId} {
      // L'écriture directe est désormais interdite aux clients : tout email
      // passe par la route serveur /api/mail/send (Admin SDK, hors règles), qui
      // authentifie l'appelant et estampille l'auteur. Auparavant
      // 'create: if isSignedIn()' laissait tout compte authentifié fabriquer
      // des emails arbitraires (spam/phishing depuis le domaine de l'école).
      allow create: if false;
      allow read, update, delete: if isSuperAdmin();
    }

    // =================================
    //     ADMIN-ONLY COLLECTIONS
    // =================================
    
    match /system_logs/{logId} {
      allow read, write: if isSuperAdmin();
    }
    
    match /system_settings/{settingId} {
      allow read: if settingId == 'default' || isSignedIn(); 
      allow write: if isSuperAdmin();
    }
    
    match /support_tickets/{ticketId} {
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow read: if isSignedIn() && (isSuperAdmin() || resource.data.userId == request.auth.uid || hasPermission(resource.data.schoolId, 'viewSupportTickets') || hasPermission(resource.data.schoolId, 'manageSupportTickets'));
      allow update: if isSuperAdmin() || hasPermission(resource.data.schoolId, 'manageSupportTickets');
      allow delete: if isSuperAdmin();
    }

    // Campagnes email/WhatsApp en masse — super-admin uniquement.
    match /campaigns/{campaignId} {
      allow read, write: if isSuperAdmin();
    }

    // File d'envoi WhatsApp alimentée par les campagnes ou les rappels
    // d'abonnement. Lecture/écriture super-admin uniquement ; les
    // intégrations serveur passent par firebase-admin (hors règles).
    match /whatsapp_outbox/{docId} {
      allow read, write: if isSuperAdmin();
    }

    // Annonces plateforme : lecture par tout utilisateur signé (pour
    // affichage du bandeau), création/suppression par super-admin
    // uniquement, update limité au tableau `dismissedBy` (auto-masquage).
    match /platform_announcements/{announcementId} {
      allow read: if isSignedIn();
      allow create, delete: if isSuperAdmin();
      allow update: if isSuperAdmin() ||
        (isSignedIn()
         && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['dismissedBy']));
    }

    // Conversations privées 1-1 entre super-admin et école (directeur).
    // - Le doc d'index est lu/écrit par le super-admin OU un membre de l'école
    //   concernée.
    // - Les messages héritent du même contrôle d'accès.
    match /school_conversations/{schoolId} {
      allow read: if isSuperAdmin() || isSchoolMember(schoolId);
      allow create, update: if isSuperAdmin() || isSchoolMember(schoolId);
      allow delete: if isSuperAdmin();

      match /messages/{messageId} {
        allow read: if isSuperAdmin() || isSchoolMember(schoolId);
        allow create: if isSignedIn()
                      && (isSuperAdmin() || isSchoolMember(schoolId))
                      && request.resource.data.senderId == request.auth.uid
                      && (
                          (isSuperAdmin() && request.resource.data.senderRole == 'admin') ||
                          (isSchoolMember(schoolId) && request.resource.data.senderRole == 'director')
                      );
        allow update, delete: if isSuperAdmin();
      }
    }

    // =================================
    //         USER DATA
    // =================================
    
    match /users/{userId} {
      // Champs à privilèges système. Ils ne doivent JAMAIS pouvoir être
      // positionnés par l'utilisateur sur son propre document : sinon
      // n'importe quel compte authentifié pourrait s'auto-octroyer l'accès
      // super-admin (`isSuperAdmin`) — qui débloque tout via isSuperAdmin() —
      // ou l'accès admin des routes /api/admin/* (`profile.isAdmin`, lu par
      // leur helper requireAdmin). Seul un super-admin déjà en place
      // (grantSuperAdmin) ou l'Admin SDK côté serveur/seeding (hors règles)
      // peut modifier ces champs.
      //
      // `schools` est logé sur le même document et mérite la même garde :
      // isSchoolMember()/isDirector()/hasPermission() ci-dessus ne lisent
      // QUE schools[schoolId] pour décider de l'appartenance et du rôle sur
      // une école. Sans cette contrainte, un simple compte authentifié
      // pourrait s'octroyer 'directeur' sur n'importe quelle école connue
      // (schoolId) en s'auto-écrivant users/{uid}.schools — sans code, sans
      // invitation — et prendre le contrôle total de ses données (élèves,
      // notes, paiements, comptabilité...). L'attribution d'une entrée
      // `schools` ne doit donc passer QUE par les routes serveur (SDK admin,
      // hors règles) qui valident un code d'école ou un code d'accès parent :
      // /api/onboarding/{create-school,join-school,join-parent}.
      //
      // `commercialAccess` débloque le pipeline prospects (/admin/system/
      // prospects et son API) sans donner accès au reste de l'espace admin.
      // Même garde que les champs ci-dessus : seul un super-admin (via
      // /api/admin/commercial, SDK admin) peut le positionner.
      function usersNoSelfEscalation() {
        return request.resource.data.get('isSuperAdmin', false) == false
            && request.resource.data.get(['profile', 'isAdmin'], false) == false
            && request.resource.data.get('schools', {}) == {}
            && request.resource.data.get('commercialAccess', false) == false;
      }
      function usersKeepsPrivileges() {
        return request.resource.data.get('isSuperAdmin', false)
                 == resource.data.get('isSuperAdmin', false)
            && request.resource.data.get(['profile', 'isAdmin'], false)
                 == resource.data.get(['profile', 'isAdmin'], false)
            && request.resource.data.get('schools', {})
                 == resource.data.get('schools', {})
            && request.resource.data.get('commercialAccess', false)
                 == resource.data.get('commercialAccess', false);
      }

      allow read, delete: if request.auth.uid == userId || isSuperAdmin();
      allow create: if isSuperAdmin()
                    || (isSignedIn() && usersNoSelfEscalation());
      allow update: if isSuperAdmin()
                    || (request.auth.uid == userId && usersKeepsPrivileges());
    }

    // =================================
    //         SCHOOL DATA
    // =================================
    
    match /ecoles/{schoolId} {
      allow read: if isSchoolMember(schoolId) || (isSignedIn() && resource.data.directorId == request.auth.uid);
      allow create: if isSignedIn() && request.resource.data.directorId == request.auth.uid;
      allow update: if hasPermission(schoolId, 'manageSettings');
      allow delete: if isSuperAdmin();
    
      // --- Sub-collections of /ecoles/{schoolId} ---

      match /personnel/{staffId} {
        // Anti-escalade de privilèges : le champ `adminRole` d'un doc personnel
        // pilote hasPermission(). Un utilisateur qui écrit son PROPRE doc
        // (request.auth.uid == staffId, hors manageUsers) ne doit donc jamais
        // pouvoir se l'attribuer ni le modifier — seul un détenteur de
        // manageUsers le peut. À la création il doit rester absent/null ; à la
        // mise à jour il doit rester identique à la valeur déjà en place.
        allow create: if hasPermission(schoolId, 'manageUsers')
                      || (request.auth.uid == staffId
                          && request.resource.data.get('adminRole', null) == null);
        allow read: if isSchoolMember(schoolId);
        allow update: if hasPermission(schoolId, 'manageUsers')
                      || (request.auth.uid == staffId
                          && request.resource.data.get('adminRole', null) == resource.data.get('adminRole', null));
        allow delete: if hasPermission(schoolId, 'manageUsers') || (resource.data.email == request.auth.token.email);
      }

      match /conges_personnel/{congeId} {
        allow create: if isSignedIn() && (hasPermission(schoolId, 'manageUsers') || request.resource.data.staffId == request.auth.uid);
        allow read: if isSchoolMember(schoolId) && (hasPermission(schoolId, 'manageUsers') || resource.data.staffId == request.auth.uid);
        allow update: if hasPermission(schoolId, 'manageUsers') || (isSignedIn() && resource.data.staffId == request.auth.uid && resource.data.status == 'En attente');
        allow delete: if hasPermission(schoolId, 'manageUsers');
      }
      
      match /parents/{parentId} {
        allow read: if isSchoolMember(schoolId) || request.auth.uid == parentId;
        allow write: if hasPermission(schoolId, 'manageUsers');
      }
      
      match /admin_roles/{roleId} {
        allow read: if isSchoolMember(schoolId);
        allow write: if hasPermission(schoolId, 'manageSettings');
      }

      // --- Élèves et leurs sous-collections ---
      
      match /eleves/{studentId} {
        allow read: if isSchoolMember(schoolId) || isParentOfStudent(schoolId, studentId);
        allow create: if hasPermission(schoolId, 'manageUsers') && passesStudentQuota(schoolId);
        allow update, delete: if hasPermission(schoolId, 'manageUsers');

        match /notes/{gradeId} {
          allow read: if hasPermission(schoolId, 'viewGrades') || isParentOfStudent(schoolId, studentId);
          allow create, update, delete: if hasPermission(schoolId, 'manageGrades');
        }
        
        // === ABSENCES (collections imbriquées sous élèves) ===
        match /absences/{absenceId} {
          allow read: if hasPermission(schoolId, 'manageAttendance') || isSchoolMember(schoolId) || isParentOfStudent(schoolId, studentId);
          allow create, update, delete: if hasPermission(schoolId, 'manageAttendance') || isSchoolMember(schoolId);
        }
        
        // === INCIDENTS DISCIPLINAIRES (collections imbriquées sous élèves) ===
        match /incidents_disciplinaires/{incidentId} {
          allow read: if hasPermission(schoolId, 'manageDiscipline') || isSchoolMember(schoolId) || isParentOfStudent(schoolId, studentId);
          allow create, update, delete: if hasPermission(schoolId, 'manageDiscipline') || isSchoolMember(schoolId);
        }
        
        match /paiements/{paymentId} {
           allow read: if hasPermission(schoolId, 'manageBilling') || isParentOfStudent(schoolId, studentId);
           allow write: if hasPermission(schoolId, 'manageBilling');
        }
        
        match /dossier_medical/{dossierId} {
          allow read: if hasPermission(schoolId, 'manageMedical') || isParentOfStudent(schoolId, studentId);
          allow write: if hasPermission(schoolId, 'manageMedical');
          
          match /{subcollection}/{docId} {
            allow read: if hasPermission(schoolId, 'manageMedical') || isParentOfStudent(schoolId, studentId);
            allow write: if hasPermission(schoolId, 'manageMedical');
          }
        }
      }
      
      // --- Collections globales de l'école ---
      
      match /cycles/{cycleId} {
        allow read: if hasPermission(schoolId, 'manageClasses');
        allow create: if hasPermission(schoolId, 'manageClasses') && passesCycleQuota(schoolId);
        allow update, delete: if hasPermission(schoolId, 'manageClasses');
      }
      match /niveaux/{niveauId} { allow read, write: if hasPermission(schoolId, 'manageClasses'); }
      match /classes/{classId} { allow read, write: if hasPermission(schoolId, 'manageClasses'); }
      match /matieres/{subjectId} { allow read, write: if hasPermission(schoolId, 'manageClasses'); }
      match /emploi_du_temps/{entryId} { allow read, write: if hasPermission(schoolId, 'manageSchedule'); }
      match /frais_scolarite/{feeId} { allow read, write: if hasPermission(schoolId, 'manageBilling'); }
      
      match /inscriptions_classe/{assignmentId} {
        allow read: if isSchoolMember(schoolId) || (isSignedIn() && isParentOfStudent(schoolId, resource.data.studentId));
        allow write: if hasPermission(schoolId, 'manageClasses');
      }

      match /academic_year_transitions/{transitionId} {
        allow read: if isSchoolMember(schoolId);
        allow write: if hasPermission(schoolId, 'manageClasses');
      }
      
      // Absences au niveau école (pour compatibilité)
      match /absences/{absenceId} {
        allow create, update, delete: if hasPermission(schoolId, 'manageAttendance');
        allow read: if hasPermission(schoolId, 'manageAttendance') || 
                     (isSignedIn() &&
                      resource.data.studentId != null &&
                      isParentOfStudent(schoolId, resource.data.studentId));
      }
      
      // Incidents au niveau école (pour compatibilité)
      match /incidents_disciplinaires/{incidentId} {
        allow create, update, delete: if hasPermission(schoolId, 'manageDiscipline');
         allow read: if hasPermission(schoolId, 'manageDiscipline') || 
                     (isSignedIn() &&
                      resource.data.studentId != null &&
                      isParentOfStudent(schoolId, resource.data.studentId));
      }
      
      match /bibliotheque/{bookId} { allow read, write: if hasPermission(schoolId, 'manageLibrary'); }
      match /bibliotheque_prets/{loanId} { allow read, write: if hasPermission(schoolId, 'manageLibrary'); }
      match /messagerie/{messageId} { allow read, write: if hasPermission(schoolId, 'manageCommunication'); }
      match /cantine_menus/{menuId} { allow read, write: if hasPermission(schoolId, 'manageCantine'); }
      match /cantine_reservations/{reservationId} { allow read, write: if hasPermission(schoolId, 'manageCantine'); }
      match /cantine_abonnements/{subscriptionId} { allow read, write: if hasPermission(schoolId, 'manageCantine'); }
      match /transport_bus/{busId} { allow read, write: if hasPermission(schoolId, 'manageTransport'); }
      match /transport_lignes/{routeId} { allow read, write: if hasPermission(schoolId, 'manageTransport'); }
      match /transport_abonnements/{subscriptionId} { allow read, write: if hasPermission(schoolId, 'manageTransport'); }
      match /internat_batiments/{buildingId} { allow read, write: if hasPermission(schoolId, 'manageInternat'); }
      match /internat_chambres/{roomId} { allow read, write: if hasPermission(schoolId, 'manageInternat'); }
      match /internat_occupants/{occupationId} { allow read, write: if hasPermission(schoolId, 'manageInternat'); }
      match /internat_entrees_sorties/{logId} { allow read, write: if hasPermission(schoolId, 'manageInternat'); }
      match /batiments/{buildingId} { allow read, write: if hasPermission(schoolId, 'manageRooms'); }
      match /salles/{salleId} { allow read, write: if hasPermission(schoolId, 'manageRooms'); }
      match /reservations_salles/{reservationId} { allow read, write: if hasPermission(schoolId, 'manageRooms'); }
      match /inventaire/{materielId} { allow read, write: if hasPermission(schoolId, 'manageInventory'); }
      match /maintenance/{tacheId} { allow read, write: if hasPermission(schoolId, 'manageInventory'); }
      match /cles_trousseaux/{trousseauId} { allow read, write: if hasPermission(schoolId, 'manageInventory'); }
      match /cles_log/{logId} { allow read, write: if hasPermission(schoolId, 'manageInventory'); }

      // --- Gestion des Stocks ---
      match /stocks/{itemId} {
        allow read: if isSchoolMember(schoolId);
        allow write: if hasPermission(schoolId, 'manageInventory');
      }
      match /stock_logs/{logId} {
        allow read: if isSchoolMember(schoolId);
        allow write: if hasPermission(schoolId, 'manageInventory');
      }

      match /activites/{activiteId} { allow read, write: if hasPermission(schoolId, 'manageActivities'); }
      match /audit_logs/{logId} {
        allow create: if isSchoolMember(schoolId);
        allow read: if hasPermission(schoolId, 'manageSettings') || isDirector(schoolId);
        allow delete: if isSuperAdmin();
      }
      match /inscriptions_activites/{inscriptionId} { allow read, write: if hasPermission(schoolId, 'manageActivities'); }
      match /competitions/{competitionId} { allow read, write: if hasPermission(schoolId, 'manageActivities'); }
      match /participations_competitions/{participationId} { allow read, write: if hasPermission(schoolId, 'manageActivities'); }
      match /payroll_runs/{runId} {
        allow read, write: if hasPermission(schoolId, 'manageBilling');
        match /payslips/{payslipId} {
          allow read, write: if hasPermission(schoolId, 'manageBilling');
        }
      }
      
      match /comptabilite/{transactionId} {
        allow read: if isSchoolMember(schoolId);
        allow write: if hasPermission(schoolId, 'manageBilling');
      }
      
      match /notifications/{notificationId} {
        allow read: if isSignedIn() && (resource.data.userId == request.auth.uid || hasPermission(schoolId, 'manageCommunication'));
        allow create: if hasPermission(schoolId, 'manageCommunication');
        allow update: if isSignedIn() && resource.data.userId == request.auth.uid;
        allow delete: if hasPermission(schoolId, 'manageCommunication');
      }

      // --- Statistiques et Finance ---
      match /stats/{statId} {
        allow read: if isSchoolMember(schoolId);
        allow write: if hasPermission(schoolId, 'manageBilling');
      }
    }

    // --- Global Collections ---

    match /visitor_chats/{chatId} {
      allow create: if true;
      allow read: if true; // Public : le visiteur anonyme lit sa propre conversation
      // Le chat visiteur est anonyme (pas d'auth), mais une mise à jour ne peut
      // désormais toucher QUE les champs attendus — empêche l'écrasement ou
      // l'injection de champs arbitraires dans un document de conversation.
      allow update: if request.resource.data.diff(resource.data)
                      .affectedKeys().hasOnly(['messages', 'lastMessageAt', 'status']);
      allow delete: if isSuperAdmin();
    }

    // =================================
    //     COLLECTION GROUP RULES
    // =================================
    
    // Necessary for dashboard recent activity and lists across all students
    //
    // 'schoolId' in resource.data d'abord : accéder à resource.data.schoolId
    // directement lève une erreur (pas juste undefined) sur un document où
    // le champ manquerait — un vieux document ou une écriture incomplète
    // suffit à faire planter toute l'évaluation de la règle au lieu de la
    // refuser proprement.

    match /{path=**}/absences/{absenceId} {
      allow read: if isSignedIn() && 'schoolId' in resource.data && (
        isSchoolMember(resource.data.schoolId) ||
        isParentOfStudent(resource.data.schoolId, resource.data.get('studentId', '__none__'))
      );
    }

    match /{path=**}/incidents_disciplinaires/{incidentId} {
      allow read: if isSignedIn() && 'schoolId' in resource.data && (
        isSchoolMember(resource.data.schoolId) ||
        isParentOfStudent(resource.data.schoolId, resource.data.get('studentId', '__none__'))
      );
    }

    match /{path=**}/notes/{noteId} {
      allow read: if isSignedIn() && 'schoolId' in resource.data && (
        isSchoolMember(resource.data.schoolId) ||
        isParentOfStudent(resource.data.schoolId, resource.data.get('studentId', '__none__'))
      );
    }

    match /{path=**}/personnel/{staffId} {
      // Used by AdminsTable and general personnel lists
      allow read: if isSignedIn() && 'schoolId' in resource.data && (isSuperAdmin() || isSchoolMember(resource.data.schoolId));
    }

    // Confidentialité médicale : la lecture via collection-group est réservée
    // aux détenteurs de manageMedical, comme sur le chemin direct
    // (ecoles/{id}/eleves/{id}/dossier_medical). Auparavant `|| isSchoolMember`
    // laissait TOUT membre du personnel (ex. cantine) lire les données de santé
    // de tous les élèves via une requête collectionGroup.
    match /{path=**}/dossier_medical/{dossierId} {
      allow read: if isSignedIn() && 'schoolId' in resource.data && hasPermission(resource.data.schoolId, 'manageMedical');
    }

    match /{path=**}/consultations/{consultationId} {
      allow read: if isSignedIn() && 'schoolId' in resource.data && hasPermission(resource.data.schoolId, 'manageMedical');
    }

    match /{path=**}/vaccins/{vaccinId} {
      allow read: if isSignedIn() && 'schoolId' in resource.data && hasPermission(resource.data.schoolId, 'manageMedical');
    }
  }
}
